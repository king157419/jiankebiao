<?xml version="1.0" encoding="utf-8"?>
<!-- 长按 App 图标弹出的静态快捷方式（像小红书的「扫一扫」）。
     静态快捷方式不需要任何权限，也不需要 App 在跑，系统装包时就读这个文件。
     每条都用显式 Intent（targetPackage + targetClass）直接拉起 MainActivity，
     action 由 MainActivity 读出来（getLaunchAction / onNewIntent）交给 Flutter 处理。
     顺序 = 长按菜单里从下往上的顺序（系统会倒着排）。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="cn.shu.schedule.action.SHORTCUT_TODAY"
            android:targetPackage="cn.shu.schedule"
            android:targetClass="cn.shu.schedule.MainActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="import"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_import"
        android:shortcutShortLabel="@string/shortcut_import_short"
        android:shortcutLongLabel="@string/shortcut_import_long">
        <intent
            android:action="cn.shu.schedule.action.SHORTCUT_IMPORT"
            android:targetPackage="cn.shu.schedule"
            android:targetClass="cn.shu.schedule.MainActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="add_widget"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add_widget"
        android:shortcutShortLabel="@string/shortcut_add_widget_short"
        android:shortcutLongLabel="@string/shortcut_add_widget_long">
        <intent
            android:action="cn.shu.schedule.action.SHORTCUT_ADD_WIDGET"
            android:targetPackage="cn.shu.schedule"
            android:targetClass="cn.shu.schedule.MainActivity" />
    </shortcut>
</shortcuts>

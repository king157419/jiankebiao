<?xml version="1.0" encoding="utf-8"?>
<!-- 「简课表」4×2 小组件（v1.4.0 另有 2×1「下一节」，见 next_widget_info；v1.5.0 起两种都能在 App 里一键添加）。
     updatePeriodMillis 最小生效值是 30 分钟，跨天刷新另外用 AlarmManager
     在每天 00:00:30 触发；v1.4.0 起每次渲染后还会按「下一节开始 / 结束、18:00、跨天」
     排一个非精确、不唤醒的重绘闹钟（见 DayWidgetProvider / WidgetStatus.kt）。
     ◀ / ▶ 翻页靠 setOnClickPendingIntent 发自定义广播，不需要 Flutter 引擎在跑。

     previewLayout / description / targetCellWidth 都是 API 31+ 才生效；
     API 30- 的启动器（以及一部分只认老字段的国产启动器，比如 vivo 的「应用挂件」）
     只看 previewImage，之前指向 @mipmap/ic_launcher 会导致预览就是一个应用图标，
     所以这里换成专门的 widget_day_preview.png。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_day"
    android:previewLayout="@layout/widget_day_preview"
    android:previewImage="@drawable/widget_day_preview"
    android:description="@string/widget_day_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
